generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Etapas válidas: NO_VENDIDO | SEGUIMIENTO | POSIBLE_COMPRA | VENDIDO (ver src/lib/stages.ts)
model Lead {
  id        Int       @id @default(autoincrement())
  fullName  String
  /// Normalizado: +549XXXXXXXXXX
  phone     String
  stage     String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Se completa al pasar a VENDIDO y se borra al salir de esa etapa
  soldAt    DateTime?

  @@index([stage])
  @@index([soldAt])
}

model MonthlyGoal {
  id     Int @id @default(autoincrement())
  year   Int
  /// 1 a 12
  month  Int
  target Int

  @@unique([year, month])
}

/// Circular FCA o lista de precios cargada para presupuestos. Se usa la última de cada tipo.
model FuentePresupuesto {
  id        Int      @id @default(autoincrement())
  /// "circular" | "lista"
  tipo      String
  /// Ej.: "Circular 016.26 · Octubre 2026" o el nombre de la hoja de la lista
  nombre    String
  /// Nombre del archivo subido
  archivo   String
  /// JSON: productos (circular) o vehículos (lista)
  datos     String
  createdAt DateTime @default(now())

  @@index([tipo, createdAt])
}

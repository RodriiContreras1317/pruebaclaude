generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Etapas válidas: NO_VENDIDO | SEGUIMIENTO | POSIBLE_COMPRA | VENDIDO (ver src/lib/stages.ts)
model Lead {
  id        Int       @id @default(autoincrement())
  fullName  String
  /// Normalizado: +549XXXXXXXXXX
  phone     String
  stage     String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Se completa al pasar a VENDIDO y se borra al salir de esa etapa
  soldAt    DateTime?

  @@index([stage])
  @@index([soldAt])
}

model MonthlyGoal {
  id     Int @id @default(autoincrement())
  year   Int
  /// 1 a 12
  month  Int
  target Int

  @@unique([year, month])
}

/// Formatos válidos: LIGA | ELIMINACION (ver src/lib/truco.ts)
model Tournament {
  id        Int      @id @default(autoincrement())
  name      String
  format    String
  /// Puntos para ganar un partido: 15 o 30
  target    Int
  createdAt DateTime @default(now())
  teams     Team[]
  matches   Match[]
}

model Team {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  /// Orden del sorteo (1 = primero)
  seed         Int
  matchesA     Match[]    @relation("TeamA")
  matchesB     Match[]    @relation("TeamB")
  wins         Match[]    @relation("Winner")

  @@index([tournamentId])
}

/// En LIGA, round es la fecha. En ELIMINACION, round es la ronda (1 = primera)
/// y el ganador pasa a (round + 1, position / 2).
model Match {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  position     Int
  teamAId      Int?
  teamA        Team?      @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId      Int?
  teamB        Team?      @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  scoreA       Int        @default(0)
  scoreB       Int        @default(0)
  winnerId     Int?
  winner       Team?      @relation("Winner", fields: [winnerId], references: [id], onDelete: Cascade)
  /// Pase libre: un equipo avanza sin jugar
  bye          Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, round, position])
}
